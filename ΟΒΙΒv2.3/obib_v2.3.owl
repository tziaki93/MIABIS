Declaration(Class(obo:UBERON_0022276))
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022276 "flexura coli splenica")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022276 "splenic flexure of colon")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022276 "splenic flexure")
AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0022276 "The splenic (or left colic) flexure is a sharp bend between the transverse and the descending colon in the left upper quadrant of humans. The left colic flexure is near the spleen, and hence called the splenic flexure. There are two colic flexures in the transverse colon &mdash; the other being the hepatic flexure in the right upper quadrant.")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022276 "left colic flexure")
AnnotationAssertion(rdfs:label obo:UBERON_0022276 "splenic flexure of colon")
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0022276 obo:uberon.owl)
SubClassOf(obo:UBERON_0022276 obo:UBERON_0000064)
Declaration(Class(obo:UBERON_0022277))
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0022277 obo:uberon.owl)
AnnotationAssertion(rdfs:label obo:UBERON_0022277 "hepatic flexure of colon")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022277 "hepatic flexure")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022277 "hepatic flexure of colon")
AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0022277 "Hepatic (or the right colic) flexure is the sharp bend between the ascending and the transverse colon. The right colic flexure is adjacent to the liver, and is therefore also known as the hepatic flexure. Thus, the left colic flexure is also known as the splenic flexure (as it is close to the spleen). The hepatic flexure lies in the right upper quadrant of the abdomen in humans.")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022277 "right colic flexure")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0022277 "flexura coli heaptica")
SubClassOf(obo:UBERON_0022277 obo:UBERON_0000064)
