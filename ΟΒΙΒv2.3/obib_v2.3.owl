Declaration(Class(obo:UBERON_0001496))
AnnotationAssertion(rdfs:label obo:UBERON_0001496 "ascending aorta")
AnnotationAssertion(obo:IAO_0000115 obo:UBERON_0001496 "The ascending aorta is the portion of the aorta in a two-pass circulatory system that lies between the heart and the arch of aorta[GO]. A portion of the aorta commencing at the upper part of the base of the left ventricle, on a level with the lower border of the third costal cartilage behind the left half of the sternum; it passes obliquely upward, forward, and to the right, in the direction of the heart's axis, as high as the upper border of the second right costal cartilage, describing a slight curve in its course, and being situated, about 6 cm behind the posterior surface of the sternum. The total length is about 5 cm in length [Wikipedia].")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0001496 "ascending thoracic aorta")
AnnotationAssertion(obo:IAO_0000118 obo:UBERON_0001496 "pars ascendens aortae")
AnnotationAssertion(obo:IAO_0000412 obo:UBERON_0001496 obo:uberon.owl)
SubClassOf(obo:UBERON_0001496 obo:UBERON_0000064)
