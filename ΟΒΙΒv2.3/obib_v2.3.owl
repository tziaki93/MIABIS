Declaration(AnnotationProperty(obo:OMO_0001001))
AnnotationAssertion(rdfs:label obo:OMO_0001001 "logical characteristic of object property")
AnnotationAssertion(obo:IAO_0000119 obo:OMO_0001001 "OBO Operations call")
AnnotationAssertion(oboInOwl:created_by obo:OMO_0001001 <http://orcid.org/0000-0001-5208-3432>)
AnnotationAssertion(obo:IAO_0000115 obo:OMO_0001001 "This is an annotation used on an object property to indicate a logical characterstic beyond what is possible in OWL.")
Declaration(AnnotationProperty(obo:OMO_0002000))
AnnotationAssertion(obo:IAO_0000233 obo:OMO_0002000 <https://github.com/ontodev/robot/issues/963>)
AnnotationAssertion(obo:IAO_0000115 obo:OMO_0002000 "Links an annotation property to a SPARQL CONSTRUCT query which is meant to provide semantics for a shortcut relation.")
AnnotationAssertion(obo:IAO_0000112 obo:OMO_0002000 "'part disjoint with' 'defined by construct' \"\"\"
    PREFIX owl: <http://www.w3.org/2002/07/owl#>
    PREFIX : <http://example.org/
    CONSTRUCT {
      [
        a owl:Restriction ;
        owl:onProperty :part_of ;
        owl:someValuesFrom ?a ;
        owl:disjointWith [
          a owl:Restriction ;
          owl:onProperty :part_of ;
          owl:someValuesFrom ?b
        ]
      ]
    }
    WHERE {
      ?a :part_disjoint_with ?b .
    }")
AnnotationAssertion(rdfs:label obo:OMO_0002000 "defined by construct")
AnnotationAssertion(dc:contributor obo:OMO_0002000 <https://orcid.org/0000-0002-8688-6599>)
AnnotationAssertion(dc:contributor obo:OMO_0002000 <https://orcid.org/0000-0002-7356-1779>)
